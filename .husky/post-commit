#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

NEED_AMEND=$(git config --local --get custom.needschangelog 2>/dev/null)

if [ "$NEED_AMEND" = "true" ]; then
  # Сбрасываем флаг как можно раньше
  git config --local --unset custom.needschangelog

  # Генерируем changelog
  npx --no-install conventional-changelog -p angular -i CHANGELOG.md -s

  # Добавляем только если файл реально изменился
  if ! git diff --quiet -- CHANGELOG.md; then
    git add CHANGELOG.md
    git commit --amend --no-edit --no-verify
  fi
fi